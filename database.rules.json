{
  "rules": {
    ".read": false,
    ".write": false,
    "cnshop": {
      "$room": {
        ".read": "$room.matches(/^[A-Z0-9]{5}$/)",
        ".write": "$room.matches(/^[A-Z0-9]{5}$/)",
        "data":   { ".validate": "newData.child('json').isString() && newData.child('json').val().length < 3000000" },
        "rec":    { "$sid": { ".validate": "newData.child('json').isString() && newData.child('json').val().length < 200000" } }
      }
    }
  }
}
